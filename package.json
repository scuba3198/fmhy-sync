{
  "name": "fmhy-sync",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A local-only Chromium extension that syncs FMHY starred bookmarks.",
  "scripts": {
    "build": "npm run res:build && vite build",
    "res:build": "rescript build",
    "res:watch": "rescript build -w",
    "test": "npm run res:build && node --test tests/BookmarkParser.test.mjs"
  },
  "dependencies": {
    "@rescript/react": "^0.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "rescript": "^12.3.0",
    "vite": "^8.2.0"
  }
}
